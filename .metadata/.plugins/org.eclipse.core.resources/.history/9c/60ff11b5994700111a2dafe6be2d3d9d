<!DOCTYPE html>
<html lang="en" xmlns:th="http://www.thymeleaf.org">

<head>
	<meta charset="UTF-8">
	<meta name="viewport" content="width=device-width, initial-scale=1.0">
	<title>Login</title>


	<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">

	<style>
		body {
			height: 100vh;
			background: #f0f2f5;
			font-family: Arial, sans-serif;
		}

		.page-wrapper {
			height: 100vh;
			display: flex;
			justify-content: center;
			align-items: center;
		}

		.login-container {
			width: 100%;
			max-width: 400px;
		}

		.login-form {
			background: #fff;
			padding: 30px;
			border-radius: 20px;
			box-shadow: 0 0 10px rgba(0, 0, 0, 0.2);
		}

		.back-btn {
			position: absolute;
			top: 20px;
			left: 20px;
		}
	</style>
</head>

<body>


	<a href="registrationpage">
		<button type="button" class="btn btn-outline-primary back-btn">
			<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="currentColor"
				class="bi bi-arrow-left-circle-fill me-1" viewBox="0 0 16 16">
				<path
					d="M8 0a8 8 0 1 0 0 16A8 8 0 0 0 8 0m3.5 7.5a.5.5 0 0 1 0 1H5.707l2.147 2.146a.5.5 0 0 1-.708.708l-3-3a.5.5 0 0 1 0-.708l3-3a.5.5 0 1 1 .708.708L5.707 7.5z" />
			</svg>
			Registration
		</button>
	</a>

	<div class="page-wrapper">
			<div class="login-container">
				<form class="login-form" action="/login" method="post" autocomplete="off">
					<h3 class="text-center mb-4">Login</h3>

					<div th:if="${error}" class="alert alert-danger text-center">
						<span th:text="${error}"></span>
					</div>

					<div class="mb-3">
						<label for="username" class="form-label">User Name</label>
						<input type="text" name="username" class="form-control" placeholder="Enter username" required>
					</div>

					<div class="mb-3">
						<label for="password" class="form-label">Password</label>
						<input type="password" name="password" class="form-control" placeholder="Enter password" required>
					</div>

					<button type="submit" class="btn btn-primary w-100 mb-3">
						Login
					</button>

					<div class="text-center">
						<a href="forgotpage" class="btn btn-link">
							Forgot Password?
						</a>
					</div>
				</form>
			</div>
		</div>

	<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
</body>

</html>
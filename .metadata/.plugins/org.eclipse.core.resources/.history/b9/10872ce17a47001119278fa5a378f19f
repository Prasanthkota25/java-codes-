	<style>
		:root {
			--bg-color: #f8f9fa;
			--text-color: #000;
			--card-bg: #ffffff;
			--navbar-color: #ffffff;
			--table-header: #0d6efd;
			--footer-bg: #222;
			--border-color: rgba(0, 0, 0, 0.1);
		}

		[data-theme="dark"] {
			--bg-color: #121212;
			--text-color: #ffffff;
			--card-bg: #1e1e1e;
			--navbar-color: #1f1f1f;
			--table-header: #0d6efd;
			--footer-bg: #000;
			--border-color: rgba(255, 255, 255, 0.15);
		}


		body {
			background-color: var(--bg-color);
			color: var(--text-color);
			font-family: Arial, sans-serif;
			margin: 0;
		}



		.navbar {
			background-color: var(--navbar-color) !important;
			border-bottom: 1px solid var(--border-color);
		}


		.navbar .nav-link {
			color: var(--text-color) !important;
		}

		.navbar .nav-link.active {
			font-weight: 600;
		}




		.container {
			margin-top: 30px;
			margin-bottom: 70px;
			background: var(--card-bg);
			padding: 25px;
			border-radius: 10px;
			box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
		}


		table {
			width: 100%;
			margin-top: 20px;
			border-collapse: collapse;
			background: var(--card-bg);
		}

		table thead {
			background-color: var(--table-header);
			color: #fff;
		}

		table th,
		table td {
			padding: 12px;
			text-align: center;
			border: 1px solid var(--border-color);
			font-size: 14px;
		}

		table tbody tr:hover {
			background-color: rgba(0, 123, 255, 0.05);
		}


		.dropdown-menu {
			background-color: var(--card-bg);
			color: var(--text-color);
			border: 1px solid var(--border-color);
		}

		.dropdown-item {
			color: var(--text-color);
		}

		.dropdown-item:hover {
			background-color: rgba(0, 123, 255, 0.1);
		}


		footer {
			position: fixed;
			bottom: 0;
			width: 100%;
			background-color: var(--footer-bg);
			color: #fff;
			text-align: center;
			padding: 10px 0;
			font-size: 14px;
		}


		#options {
			display: none;
			margin: 10px 40px;
			padding: 15px;
			width: 220px;
			background-color: var(--card-bg);
			border: 1px solid var(--border-color);
			border-radius: 10px;
			box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
		}

		#options button {
			width: 100%;
			padding: 10px;
			margin: 5px 0;
			border: none;
			border-radius: 6px;
			background-color: #0d6efd;
			color: white;
		}

		#options button:hover {
			background-color: #084298;
		}


		.nav-underline .nav-link {
			padding-right: 20px;
			padding-left: 15px;
		}
	</style>

	<div class="container mt-5">
		<h2 class="mb-4">Apply Leave</h2>

		<form>


			<div class="row g-3">

				<div class="col-md-4">
					<label class="form-label">Employee Name</label>
					<input type="text" class="form-control" value="Employee Name" readonly>
				</div>

				<div class="col-md-4">
					<label class="form-label">Leave Type</label>
					<select class="form-select" name="leave_type">
						<option selected disabled>Select</option>
						<option>Sick Leave</option>
						<option>Casual Leave</option>
						<option>Paid Leave</option>
					</select>
				</div>

				<div class="col-md-4">
					<label class="form-label">Leave Balance</label>
					<input type="text" class="form-control" placeholder="Leave Balance">
				</div>

			</div>


			<div class="row g-3 mt-1">

				<div class="col-md-4">
					<label class="form-label">From Date</label>
					<input type="date" class="form-control">
				</div>

				<div class="col-md-4">
					<label class="form-label">To Date</label>
					<input type="date" class="form-control">
				</div>

				<div class="col-md-4">
					<label class="form-label">No. of Days</label>
					<input type="number" class="form-control">
				</div>

			</div>


			<div class="row g-3 mt-1">

				<div class="col-md-4">
					<label class="form-label">Approver</label>
					<input type="text" class="form-control" value="Manager" re>
				</div>

				<div class="col-md-4">
					<label class="form-label">Contact Number</label>
					<input type="text" class="form-control" placeholder="Phone Number">
				</div>

				<div class="col-md-4">
					<label class="form-label">Reason</label>
					<textarea class="form-control" rows="1"></textarea>
				</div>

			</div>


			<div class="mt-4 d-flex justify-content-end gap-2">
				<button type="reset" class="btn btn-secondary">Reset</button>
				<button type="submit" class="btn btn-primary">Submit</button>
			</div>

		</form>
	</div>





	<div class="container">

		<h2>Leave History</h2>

		<div class="table-responsive">
			<table class="table table-bordered table-hover align-middle text-center">
				<thead class="table-primary">
					<tr>
						<th>Leave Type</th>
						<th>Comp-Off Date</th>
						<th>From Date</th>
						<th>To Date</th>
						<th>Status</th>
						<th>Request Type</th>
						<th>No. of Days</th>
						<th>Reason</th>
						<th>Approver Remarks</th>
						<th>Action</th>
					</tr>
				</thead>

				<tbody>
					<tr>
						<td colspan="10" class="text-center text-muted py-4">
							No data found
						</td>
					</tr>
				</tbody>

			</table>
		</div>

	</div>

	<script>
		function showOptions() {
			document.getElementById("options").style.display = "block";
		}

		/* Theme switcher */
		function setTheme(theme) {
			document.documentElement.setAttribute("data-theme", theme);
			localStorage.setItem("theme", theme);
		}

		/* Load saved theme */
		window.onload = function () {
			const savedTheme = localStorage.getItem("theme");
			if (savedTheme) {
				document.documentElement.setAttribute("data-theme", savedTheme);
			}
		};
	</script>

	<footer>
		<div>
			Infinite Computer
		</div>
	</footer>
	<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"></script>


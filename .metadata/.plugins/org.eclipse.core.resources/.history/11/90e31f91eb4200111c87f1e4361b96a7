package javaCollectionsAll;

import java.util.ArrayList;
import java.util.Comparator;
import java.util.List;

class student {
	int age;
	String name;

	public student(int age, String name) {
		super();
		this.age = age;
		this.name = name;
	}

	public String toString() {
		return "student [age=" + age + ", name=" + name + "]";
	}

}


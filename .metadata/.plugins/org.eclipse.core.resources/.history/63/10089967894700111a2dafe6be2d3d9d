package com.example.demo.userController;

import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.stereotype.Controller;
import org.springframework.web.bind.annotation.GetMapping;
import org.springframework.web.bind.annotation.ModelAttribute;
import org.springframework.web.bind.annotation.PostMapping;

@Controller
public class Usercontroller {

	@Autowired
	private Userservice service;

	@GetMapping("/registrationpage")
	public String registrationpage() {
		return "registrationpage";
	}

	@GetMapping("/loginpage")
	public String loginpage() {
		return "loginpage";
	}

	@GetMapping("/forgotpage")
	public String forgotpage() {
		return "forgotpage";
	}

	@GetMapping("/HomePage")
	public String HomePage() {
		return "HomePage";
	}

	@GetMapping("/profilepage")
	public String profilepage() {
		return "profilepage";
	}

	@GetMapping("/ApplyforLeave")
	public String ApplyforLeave() {
		return "ApplyforLeave";
	}

	@GetMapping("/leaveBalance")
	public String leaveBalance() {
		return "leaveBalance";
	}

	@GetMapping("/Myteamleave")
	public String Myteamleave() {
		return "Myteamleave";
	}

	@PostMapping("/registration")
	public String registration(@ModelAttribute("userObj") Userentity user) {
		service.registration(user);
		return loginpage;
	}

}

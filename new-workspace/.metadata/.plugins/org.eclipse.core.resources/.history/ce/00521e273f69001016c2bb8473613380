	public static int[] sortByDigitSum(int[] arr) {
		int n = arr.length;
		for (int i = 0; i < n - 1; i++) {//0, 4 1
			for (int j = 0; j < n -i- 1 ; j++) {//0,3
					
				int temp = arr[j];
				arr[j] = arr[j + 1];
				arr[j + 1] = temp;
			}
		}
		return arr;
	}

}
